# ---- Proxmox connection ----
# Host or URL of any node in the cluster. "192.168.1.10" becomes
# "https://192.168.1.10:8006". Point this at a stable node or a VIP.
PROXMOX_HOST=192.168.1.10
# Full API token id: user@realm!tokenname
PROXMOX_TOKEN_ID=mcp@pve!homelab
# The token secret (shown only once when you create the token).
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "true" to accept self-signed TLS certs (typical for homelab Proxmox).
PROXMOX_ALLOW_SELF_SIGNED=true
# "true" to register only read-only tools (omit all write tools).
PROXMOX_READONLY=false

# ---- MCP HTTP server ----
# Bearer token every client must send: Authorization: Bearer <this>.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# Port to listen on (container-internal).
MCP_HTTP_PORT=3000
# Port published on the host by docker compose. Change this if 3000 is already
# taken on the machine you are deploying to.
MCP_HOST_PORT=3000
# Bind address. 0.0.0.0 makes it reachable from other containers/LAN.
MCP_HTTP_HOST=0.0.0.0
# Set to "true" to run WITHOUT auth. Only on a trusted, isolated network.
# MCP_ALLOW_NO_AUTH=false
