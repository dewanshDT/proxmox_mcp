# ---- Proxmox connection ----
# Host or URL of any node in the cluster. "192.168.1.10" becomes
# "https://192.168.1.10:8006". Point this at a stable node or a VIP.
PROXMOX_HOST=192.168.1.10
# Full API token id: user@realm!tokenname
PROXMOX_TOKEN_ID=mcp@pve!homelab
# The token secret (shown only once when you create the token).
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# "true" to accept self-signed TLS certs (typical for homelab Proxmox).
PROXMOX_ALLOW_SELF_SIGNED=true
# Master off-switch; also see PROXMOX_WRITE_TOOLS below. "true" registers only
# read-only tools, forces the write set empty, and overrides PROXMOX_WRITE_TOOLS
# (a warning is logged if both are set).
PROXMOX_READONLY=false
# Which write tools to register. Comma-separated list of group aliases and/or
# exact tool names. Whitespace-trimmed, case-insensitive. An unknown entry makes
# the server refuse to start, naming the bad token.
#   Aliases:
#     lifecycle    proxmox_guest_start, proxmox_guest_shutdown, proxmox_guest_reboot
#     snapshot     proxmox_snapshot_create
#     destructive  proxmox_guest_stop, proxmox_snapshot_delete, proxmox_snapshot_rollback
#     exec         proxmox_guest_exec, proxmox_guest_exec_status
#     all          every write tool
#   Examples:
#     PROXMOX_WRITE_TOOLS=lifecycle,snapshot                    # safe reversible set
#     PROXMOX_WRITE_TOOLS=lifecycle,proxmox_snapshot_rollback   # a group plus one exact tool
#     PROXMOX_WRITE_TOOLS=lifecycle,snapshot,exec               # + in-guest command execution (QEMU agent)
#     PROXMOX_WRITE_TOOLS=all                                   # everything
# Left unset with PROXMOX_READONLY off, it falls back to "lifecycle,snapshot"
# with a deprecation warning; "destructive" and "exec" are never enabled
# implicitly. PROXMOX_READONLY=true overrides this entirely.
# PROXMOX_WRITE_TOOLS=lifecycle,snapshot

# ---- MCP HTTP server ----
# Bearer token every client must send: Authorization: Bearer <this>.
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
# Port to listen on (container-internal).
MCP_HTTP_PORT=3000
# Port published on the host by docker compose. Change this if 3000 is already
# taken on the machine you are deploying to.
MCP_HOST_PORT=3000
# Bind address. 0.0.0.0 makes it reachable from other containers/LAN.
MCP_HTTP_HOST=0.0.0.0
# Set to "true" to run WITHOUT auth. Only on a trusted, isolated network.
# MCP_ALLOW_NO_AUTH=false
